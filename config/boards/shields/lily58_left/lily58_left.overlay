// This line includes the default shield definitions, including I2C configuration
#include "../lily58.dtsi" 

&default_display {
    // Rotation for the left side
    #if defined(CONFIG_ZMK_DISPLAY_STATUS_SCREEN_REVERSE)
    rotation = <0>;
    #else
    rotation = <180>;
    #endif

    widgets {
        status_screen {
            compatible = "zmk,widget-status-screen";
            status {
                compatible = "zmk,widget-output-status";
                position = <0 0>;
            };
            battery {
                compatible = "zmk,widget-battery-status";
                position = <0 9>;
            };
            layer {
                compatible = "zmk,widget-layer-status";
                position = <0 25>;
            };
        };
    };
};

/ {
    // Encoder definition
    encoders {
        compatible = "ec11";
        status = "okay";
        encoder_left: encoder_left {
            // Using pin numbers 31 and 32 on GPIO controller 0
            a-gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
            b-gpios = <&gpio0 32 (GPIO_PULL_UP | GPIO_ACTIVE_HIGH)>;
            steps = <4>; 
            status = "okay";
        };
    };
    
    // Sensor binding definition for the encoder
    sensors {
        compatible = "zmk,sensors";
        #address-cells = <1>;
        #size-cells = <0>;
        
        encoder_left_sensor: encoder_left_sensor@0 {
            compatible = "zmk,encoder-sensor";
            status = "okay";
            encoder = <&encoder_left>;
        };
    };

    behaviors {
        compatible = "zmk,behaviors";
        label = "ZMK_BEHAVIORS";
    };
};
