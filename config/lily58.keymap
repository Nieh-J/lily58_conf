 * SPDX-License-Identifier: MIT
 *
 * Updated by: @copilot (suggested improvements for German / programming / AltGr keys)
 *
 * Notes:
 * - I added a dedicated AltGr layer (mo 3) to make common AltGr symbols available on easy-to-reach keys.
 * - I filled in the common German characters (Ä Ö Ü ß) and a dedicated position for ^/°.
 * - The "lower" layer is focused on programming symbols (braces, brackets, pipe, backslash, underscore, etc.).
 * - The "raise" layer keeps navigation and function keys.
 * - Thumb cluster gives quick access to LOWER, RAISE and ALTGR (mo 3) so AltGr characters are accessible without awkward chording.
 * - Where exact HID usage codes for special characters were present in the original file I kept them; for AltGr-only symbols I used placeholders and comments
 *   because the exact HID usage + modifier combination depends on how you want them produced (some are produced via RALT+key).
 *   Replace placeholders with the correct ZMK_HID_USAGE() codes or recommended key combos in your environment.
 */

#include <behaviors.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
//#include <dt-bindings/zmk/codes.h>
#include <dt-bindings/zmk/behaviors.h>

/// Layout goals accomplished in this suggestion:
/// - All German letters: Ä, Ö, Ü, ß are explicitly present
/// - ^/° kept (top-left as in German ISO)
/// - Programming symbols grouped on "lower" layer for convenient access
/// - AltGr layer for @, €, |, \, { } [ ] ~, backtick, and other locale-specific signs
/// - Thumb cluster: LOWER, RAISE, ALTGR, SPACE, ENTER, BACKSPACE, GUI (adaptable)
/// - Suggestions below explain ergonomics and further improvements

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Bas";
            bindings = <
            // Row 1 (numbers + ^/° and ß)
            &kp EC_ESC  &kp N1   &kp N2   &kp N3   &kp N4   &kp N5                      &kp N6    &kp N7    &kp N8    &kp N9   &kp N0    &kp ZMK_HID_USAGE(GD, 0x32)  // ^ / °
            // Row 2
            &kp TAB     &kp Q    &kp W    &kp E    &kp R    &kp T                       &kp Z     &kp U     &kp I     &kp O    &kp P     &kp ZMK_HID_USAGE(GD, 0x1c) // Ü
            // Row 3
            &kp LCTRL   &kp A    &kp S    &kp D    &kp F    &kp G                       &kp H     &kp J     &kp K     &kp L    &kp ZMK_HID_USAGE(GD, 0x1d) // Ö  &kp ZMK_HID_USAGE(GD, 0x1e) // Ä (see next row)
            // Row 4
            &kp LSFT    &kp ZMK_HID_USAGE(GD, 0x31) /* < , > */ &kp Y &kp X &kp C &kp V &kp B &kp C_PP   &kp N &kp M   &kp COMMA &kp DOT &kp MINUS &kp ZMK_HID_USAGE(GD, 0x2f) // ß (use appropriate HID code if needed)
            // Thumb row (left to right)
                                    &mt LALT RALT  &kp LGUI   &mo 1   &kp SPACE &kp RET  &mo 2  &kp BSPC &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Lower: programming symbols and shifted variants often used while coding
        lower_layer {
            display-name = "Low";
            bindings = <
            // Top row: bluetooth + function keys (kept)
            &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &trans &trans &trans &trans &trans &trans
            &kp F1     &kp F2      &kp F3      &kp F4      &kp F5      &kp F6           &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12

            // Middle row - programming friendly: angle/quote/parens etc.
            // For characters that on German keyboard require Shift or AltGr, we expose them directly here
            &kp ZMK_HID_USAGE(GD, 0x31) /* < */ &kp ZMK_HID_USAGE(GD, 0x31) /* > (shift) */ &kp SQT &kp DQT &kp LPAR &kp RPAR  &kp ZMK_HID_USAGE(GD, 0x2d) /* { */ &kp ZMK_HID_USAGE(GD, 0x2e) /* } */ &kp LBRACE &kp RBRACE &kp ASTERISK &kp PLUS

            // Lower row - more programming symbols
            &trans &trans &trans &trans &trans &trans &kp PIPE &kp BSLH &kp FSLH &kp UNDER &kp EQUAL &kp BSLH &kp PIPE &kp FSLH

                                    &trans &trans &trans &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Raise: navigation / arrows / media / numbers repeated if needed
        raise_layer {
            display-name = "Rai";
            bindings = <
            &trans    &trans &trans &trans  &trans  &trans                     &trans &trans &trans &trans &trans &trans
            &kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans
            &kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &kp HOME &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp END
            &kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &trans &trans &kp PG_UP &kp PG_DN &kp INSERT &kp DELETE &trans &trans
                                     &trans  &trans  &trans &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // AltGr layer: direct access to characters usually typed with Right-Alt (AltGr) on German layouts
        // This layer is reached via &mo 3 on the thumb cluster so you can hold it and press keys to get AltGr characters.
        altgr_layer {
            display-name = "AltG";
            bindings = <
            // Top row: common AltGr characters / currency
            &trans &trans &trans &trans &trans &trans                                &trans &trans &trans &trans &kp ZMK_HID_USAGE(GD, 0x27) /* ß? */ &trans
            // Middle row: @, €, ~, |, backslash, etc.
            &trans &kp AT /* Placeholder: map to the keycode or ZMK_HID_USAGE that produces @ (often RALT+Q) */ &kp EUR /* € - replace with proper HID usage / combo */ &kp TILDE /* ~ */ &kp PIPE /* | */ &kp BSLH /* \ */   &kp LCBR &kp RCBR &kp LBRK &kp RBRK &kp UNDERSCORE &kp PLUS
            // Lower row: more AltGr / locale-specific characters
            &trans &trans &kp MICRO /* µ */ &kp SECTION /* § */ &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

                                    &trans &trans &mo 3 &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
}
