#include <behaviors.dtsi>

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
//#include <dt-bindings/zmk/codes.h>
#include <dt-bindings/zmk/behaviors.h>

/ {
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BSPC |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Z   |  U    |  I    |  O   |   P   |   +   |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L    |   Ö   |   Ä   |
// | SHIFT |  Y  |  X  |  C   |  V   |  B   | PLAY  |  |       |  N   |  M    |  ,    |  .    |   -   | SHIFT |
//                     | ALT  | GUI  | LOWER| SPACE |  | ENTER | RAISE| RALT  | CTRL  |
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                     &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                      &kp Z  &kp U    &kp I     &kp O   &kp P    &kp MINUS
&kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                      &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&mt LSHFT CAPS &kp Y  &kp X  &kp C    &kp V    &kp B  &kp C_PP   &none    &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                        &kp LALT &kp LGUI &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RALT &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Code";
// ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |       |  @  |  {  |  }   |  \   |  |   |                   | PGUP |  HOME |   ^   |  END |       |       |
// |       |  #  |  [  |  ]   |  $   |  %   |                   | PGDN |   <-  |   v   |  ->  |       |       |
// |       |     |     |      |      |      |       |  |       |      |       |       |      |       |       |
//                     |      |      |      |       |  |       |      |       |       |
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                       &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans     &kp RA(Q) &kp RA(N7) &kp RA(N0) &kp RA(BSLH) &kp RA(NUBS)            &kp PG_UP &kp HOME  &kp UP    &kp END   &trans    &trans
&trans     &kp RA(N3) &kp RA(N8) &kp RA(N9) &kp RA(N4) &kp LS(N5)               &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
&trans     &trans    &trans    &trans    &trans    &trans    &trans   &trans    &trans    &trans    &trans    &trans    &trans    &trans
                               &trans    &trans    &trans    &trans   &trans    &trans    &trans    &trans
            >;
        };

        raise_layer {
            display-name = "BT";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4             &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans                   &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans                   &trans &trans &trans &trans &trans &trans
&trans     &trans       &trans       &trans       &trans       &trans  &trans   &trans  &trans &trans &trans &trans &trans &trans
                                     &trans       &trans       &trans  &trans   &trans  &trans &trans &trans
            >;
        };
    };
};
