#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/labels.h>

keymap {
    compatible = "zmk,keymap";

    default_layer {
        display-name = "Bas_DE";
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  ^/°  |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Z   |  U    |  I    |  O   |   P   |   Ü   |
            // | CTRL  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   Ö   |   Ä   |
            // | SHIFT | <|> |  Y  |  X   |  C   |  V   |   B  |           |  N   |  M    |  ,    |  .   |   -   | # |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |
            // ------------------------------------------------------------------------------------------------------------

            // Zeile 1
            &kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                      &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp CARET  // ^ Keycode
            // Zeile 2
            &kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                       &kp Z  &kp U    &kp I     &kp O   &kp P    &kp UE     // Ü Keycode
            // Zeile 3
            &kp LCTRL &kp A  &kp S  &kp D    &kp F    &kp G                       &kp H  &kp J    &kp K     &kp L   &kp OE     // Ö Keycode &kp AE     // Ä Keycode
            // Zeile 4 (ACHTUNG: Y und Z sind im deutschen QWERTZ getauscht)
            &kp LSFT   &kp LA_LT &kp Y  &kp X  &kp C    &kp V    &kp B  &kp C_PP   &kp N  &kp M    &kp COMMA &kp DOT &kp MINUS  &kp HASH
            // Daumen-Zeile
                                     &mt LALT RALT &kp LGUI &mo 1  &kp SPACE  &kp RET  &mo 2  &kp BSPC &kp RGUI
        >;

        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    lower_layer {
        display-name = "Low_Sym";
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |  < |  >  |  "  |  '   |  (   |  )   |                   |  {   |  }    |  [    |  ]  |   *   |   +   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  =    |  \   |   |   |   / |
            // ------------------------------------------------------------------------------------------------------------

            &bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &trans    &trans    &trans          &trans    &trans    &trans
            &kp F1     &kp F2        &kp F3       &kp F4       &kp F5       &kp F6                       &kp F7    &kp F8    &kp F9          &kp F10   &kp F11   &kp F12
            // Programmier-Symbole: Alle diese Codes sind standardmäßig in ZMK verfügbar
            &kp LA_LT  &kp LA_GT     &kp DQT      &kp SQT      &kp LPAR     &kp RPAR                     &kp LBRC  &kp RBRC  &kp LBKT        &kp RBKT  &kp ASTERISK &kp PLUS
            // Programmier-Symbole auf der unteren Reihe
            &trans     &trans        &trans       &trans       &trans       &trans    &trans   &trans    &trans    &kp UNDER  &kp EQUAL     &kp BSLH  &kp PIPE  &kp FSLH
                                     &trans       &trans       &trans       &trans   &trans    &trans    &trans    &trans    &trans
        >;

        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    raise_layer {
        display-name = "Rai_Nav";
        bindings = <
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |  ` |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |   |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   | Home |   <-  |   v   |  ^   |  ->   | End |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       | PgUp | PgDn  |  Ins  | Del  |       |       |
            // ------------------------------------------------------------------------------------------------------------
            &trans    &trans &trans &trans  &trans  &trans                       &trans      &trans    &trans    &trans   &trans    &trans
            &kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6      &kp N7    &kp N8    &kp N9   &kp N0    &trans
            &kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &kp HOME    &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &kp END
            &kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &trans   &trans    &kp PG_UP   &kp PG_DN &kp INSERT &kp DELETE &trans &trans
                                     &trans  &trans  &trans    &trans   &trans    &trans      &trans    &trans
        >;

        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
};
